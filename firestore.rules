rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // HELPERS
    // ================================================================
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function me() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        && me().status == 'ACTIVE';
    }

    function role() {
      return isActive() ? me().role : null;
    }

    function isSuperAdmin()   { return role() == 'SUPER_ADMIN'; }
    function isGalleryAdmin() { return role() == 'GALLERY_ADMIN'; }
    function isTechnician()   { return role() == 'TECHNICIAN'; }
    function isShopOwner()    { return role() == 'SHOP_OWNER'; }
    function isShopWorker()   { return role() == 'SHOP_WORKER'; }

    function myGalleryIds() {
      return isActive() && me().galleryIds is list ? me().galleryIds : [];
    }
    function myShopIds() {
      return isActive() && me().shopIds is list ? me().shopIds : [];
    }

    function inGallery(gid) {
      return isSuperAdmin() || (gid is string && gid in myGalleryIds());
    }
    function inShop(sid) {
      return isSuperAdmin() || (sid is string && sid in myShopIds());
    }

    // Champs calculés — interdits en écriture directe via update de shop (sauf service).
    function shopComputedFields() {
      return [
        'totalPurchasedKwh', 'totalConsumedKwh', 'remainingKwh', 'remainingAmount',
        'averageDailyConsumptionKwh', 'estimatedDaysRemaining',
        'estimatedDepletionDate', 'balanceStatus', 'lastBalanceCalculatedAt',
        'lastReadingAt', 'lastPurchaseAt', 'activePricePerKwh',
      ];
    }

    // ================================================================
    // USERS
    // ================================================================
    match /users/{userId} {
      // Lecture : soi-même, SUPER_ADMIN, ou admin de la même galerie.
      allow get: if isSignedIn() && (
        userId == uid()
        || isSuperAdmin()
        || (isGalleryAdmin()
          && resource.data.galleryIds is list
          && resource.data.galleryIds.hasAny(myGalleryIds()))
      );

      // Création gérée : seul un administrateur autorisé peut créer le profil
      // associé au compte Auth nouvellement créé.
      allow create: if isActive()
        && userId == request.resource.data.uid
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.role in [
          'GALLERY_ADMIN', 'TECHNICIAN', 'SHOP_OWNER', 'SHOP_WORKER', 'SUPER_ADMIN'
        ]
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'username', 'usernameNormalized',
          'firstName', 'lastName', 'fullName', 'role', 'status',
          'galleryIds', 'shopIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.galleryIds is list
        && request.resource.data.shopIds is list
        && (
          isSuperAdmin()
          || (
            isGalleryAdmin()
            && request.resource.data.role in ['TECHNICIAN', 'SHOP_OWNER', 'SHOP_WORKER']
            && request.resource.data.galleryIds.size() == 1
            && request.resource.data.galleryIds.hasOnly(myGalleryIds())
            && (
              (request.resource.data.role == 'TECHNICIAN'
                && request.resource.data.shopIds.size() == 0)
              || (
                request.resource.data.role in ['SHOP_OWNER', 'SHOP_WORKER']
                && request.resource.data.shopIds.size() == 1
                && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopIds[0]))
                && get(/databases/$(database)/documents/shops/$(request.resource.data.shopIds[0])).data.galleryId
                   in myGalleryIds()
              )
            )
          )
        );

      // Le SUPER_ADMIN gère tout compte. Un admin de galerie peut archiver
      // les techniciens et comptes boutique de ses galeries, sans changer leurs rôles.
      allow update: if isSignedIn()
        && (
          isSuperAdmin()
          || (
            isGalleryAdmin()
            && userId != uid()
            && resource.data.role in ['TECHNICIAN', 'SHOP_OWNER', 'SHOP_WORKER']
            && resource.data.galleryIds is list
            && resource.data.galleryIds.hasAny(myGalleryIds())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firstName', 'lastName', 'fullName', 'phone', 'updatedAt'
            ])
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.galleryIds == resource.data.galleryIds
            && request.resource.data.shopIds == resource.data.shopIds
          )
          || (
            isGalleryAdmin()
            && userId != uid()
            && resource.data.role in ['TECHNICIAN', 'SHOP_OWNER', 'SHOP_WORKER']
            && resource.data.galleryIds is list
            && resource.data.galleryIds.hasAny(myGalleryIds())
            && request.resource.data.status == 'ARCHIVED'
            && request.resource.data.archivedByUserId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'archivedAt', 'archivedByUserId', 'archiveReason'
            ])
          )
          || (
            userId == uid()
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.galleryIds == resource.data.galleryIds
            && request.resource.data.shopIds == resource.data.shopIds
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );

      allow delete: if false;
      // Les admins de galerie passent par le sous-ensemble /galleries/{gid}/members.
      // La collection users entière reste réservée au superadmin.
      allow list: if isSuperAdmin();
    }

    // ================================================================
    // USERNAMES — get public (login), list interdit
    // ================================================================
    match /usernames/{normalized} {
      allow get: if true;
      allow list: if false;
      // L'entrée username et le profil Auth sont créés dans la même transaction.
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && request.resource.data.uid is string
        && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.usernameNormalized == normalized
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.email == request.resource.data.email
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.createdByUserId == uid();
      allow update, delete: if false;
    }

    // ================================================================
    // GALLERIES
    // ================================================================
    match /galleries/{gid} {
      allow get: if isSignedIn() && (isSuperAdmin() || gid in myGalleryIds());
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.status == 'ACTIVE';
      allow update: if isSignedIn()
        && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'address', 'city', 'country', 'phone', 'email', 'currency',
          'defaultPricePerKwh', 'lowCreditThresholdKwh', 'criticalCreditThresholdKwh',
          'updatedAt', 'updatedByUserId'
        ]);
      allow delete: if false;

      match /admins/{adminUid} {
        allow read: if isSignedIn() && (isSuperAdmin() || gid in myGalleryIds());
        allow write: if isSignedIn() && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()));
      }

      match /members/{memberUid} {
        allow read: if isActive() && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()));
        allow create, update: if isActive()
          && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()))
          && request.resource.data.uid == memberUid
          && existsAfter(/databases/$(database)/documents/users/$(memberUid))
          && getAfter(/databases/$(database)/documents/users/$(memberUid)).data.galleryIds is list
          && gid in getAfter(/databases/$(database)/documents/users/$(memberUid)).data.galleryIds;
        allow delete: if isActive() && isSuperAdmin();
      }

      match /technicians/{techUid} {
        allow read: if isSignedIn() && (isSuperAdmin() || gid in myGalleryIds());
        allow write: if isSignedIn() && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()));
      }

      match /tariffs/{tariffId} {
        allow read: if isSignedIn() && (isSuperAdmin() || gid in myGalleryIds());
        allow write: if isSignedIn() && (isSuperAdmin() || (isGalleryAdmin() && gid in myGalleryIds()));
      }

      match /powerEvents/{eventId} {
        allow read: if isSignedIn() && (isSuperAdmin() || gid in myGalleryIds());
        allow create: if isSignedIn()
          && (isSuperAdmin() || isGalleryAdmin() || isTechnician())
          && gid in myGalleryIds() || isSuperAdmin()
          && request.resource.data.declaredByUserId == uid();
        allow update, delete: if false;
      }
    }

    // ================================================================
    // SHOPS
    // ================================================================
    match /shops/{shopId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds())
        || (isTechnician() && resource.data.galleryId in myGalleryIds())
        || shopId in myShopIds()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.galleryId in myGalleryIds() || isSuperAdmin();
      allow update: if isSignedIn()
        && (isSuperAdmin()
          || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds()))
        && request.resource.data.galleryId == resource.data.galleryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'location', 'description', 'customPricePerKwh',
          'lowCreditThresholdKwh', 'criticalCreditThresholdKwh',
          'totalPurchasedKwh', 'totalConsumedKwh', 'remainingKwh', 'remainingAmount',
          'averageDailyConsumptionKwh', 'estimatedDaysRemaining', 'estimatedDepletionDate',
          'balanceStatus', 'activePricePerKwh', 'lastBalanceCalculatedAt',
          'lastReadingAt', 'lastPurchaseAt', 'updatedAt', 'updatedByUserId'
        ]);
      allow delete: if false;
    }

    // ================================================================
    // METERS
    // ================================================================
    match /meters/{meterId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds())
        || (isTechnician() && resource.data.galleryId in myGalleryIds())
        || (resource.data.shopId != null && resource.data.shopId in myShopIds())
      );
      allow create: if isActive()
        && (isSuperAdmin() || isGalleryAdmin())
        && (request.resource.data.galleryId in myGalleryIds() || isSuperAdmin())
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.type in ['MAIN', 'SUB_METER']
        && request.resource.data.code is string
        && (
          (request.resource.data.type == 'MAIN'
            && request.resource.data.shopId == null
            && request.resource.data.parentMeterId == null)
          ||
          (request.resource.data.type == 'SUB_METER'
            && request.resource.data.shopId is string
            && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
            && get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.galleryId == request.resource.data.galleryId
            && (request.resource.data.parentMeterId == null
              || (request.resource.data.parentMeterId is string
                && exists(/databases/$(database)/documents/meters/$(request.resource.data.parentMeterId))
                && get(/databases/$(database)/documents/meters/$(request.resource.data.parentMeterId)).data.galleryId == request.resource.data.galleryId
                && get(/databases/$(database)/documents/meters/$(request.resource.data.parentMeterId)).data.type == 'MAIN'
                && get(/databases/$(database)/documents/meters/$(request.resource.data.parentMeterId)).data.status == 'ACTIVE')))
        );
      allow update: if isSignedIn()
        && (isSuperAdmin()
          || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds()))
        && request.resource.data.galleryId == resource.data.galleryId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'serialNumber', 'description', 'lastTotalKwh', 'lastValidReadingId',
          'lastReadingAt', 'totalPurchasedKwh', 'totalPurchaseAmount', 'totalConsumedKwh',
          'remainingKwh', 'remainingAmount', 'currency', 'activePricePerKwh',
          'balanceStatus', 'lastBalanceCalculatedAt', 'updatedAt', 'updatedByUserId'
        ]);
      allow delete: if false;
    }

    // ================================================================
    // READINGS — écriture autorisée aux rôles métier, mais champs calculés
    // doivent être cohérents (consommation = total - previousTotal)
    // ================================================================
    match /readings/{readingId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds())
        || (resource.data.shopId != null && resource.data.shopId in myShopIds())
      );
      allow create: if isSignedIn()
        && (isSuperAdmin() || isGalleryAdmin() || isTechnician())
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.galleryId in myGalleryIds() || isSuperAdmin()
        && request.resource.data.totalKwh is number
        && request.resource.data.totalKwh >= 0
        && request.resource.data.status == 'VALID'
        && request.resource.data.source == 'MANUAL'
        && request.resource.data.consumptionKwh ==
           request.resource.data.totalKwh - request.resource.data.previousTotalKwh;
      allow update: if isSignedIn()
        && (isSuperAdmin() || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds()));
      allow delete: if false;
    }

    // ================================================================
    // ENERGY PURCHASES — écriture par rôles autorisés
    // ================================================================
    match /energyPurchases/{purchaseId} {
      allow read: if isSignedIn()
        && !isShopWorker()
        && (
          isSuperAdmin()
          || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds())
          || (resource.data.shopId != null && resource.data.shopId in myShopIds())
        );
      allow create: if isActive()
        && (isSuperAdmin() || isGalleryAdmin())
        && (isSuperAdmin() || request.resource.data.galleryId in myGalleryIds())
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.meterId is string
        && exists(/databases/$(database)/documents/meters/$(request.resource.data.meterId))
        && get(/databases/$(database)/documents/meters/$(request.resource.data.meterId)).data.galleryId == request.resource.data.galleryId
        && get(/databases/$(database)/documents/meters/$(request.resource.data.meterId)).data.shopId == request.resource.data.shopId
        && get(/databases/$(database)/documents/meters/$(request.resource.data.meterId)).data.status == 'ACTIVE'
        && request.resource.data.status == 'VALID'
        && request.resource.data.purchasedKwh is number
        && request.resource.data.purchasedKwh > 0
        && request.resource.data.totalAmount >=
           request.resource.data.purchasedKwh * request.resource.data.pricePerKwh - 0.01
        && request.resource.data.totalAmount <=
           request.resource.data.purchasedKwh * request.resource.data.pricePerKwh + 0.01;
      allow update: if isSignedIn()
        && (isSuperAdmin() || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds()))
        // seule l'annulation (passage VALID → CANCELLED) est autorisée
        && resource.data.status == 'VALID'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.cancelledByUserId == uid();
      allow delete: if false;
    }

    // ================================================================
    // ALERTS
    // ================================================================
    match /alerts/{alertId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds())
        || (resource.data.shopId != null && resource.data.shopId in myShopIds())
      );
      allow create: if isSignedIn(); // le service écrit les alertes
      allow update: if isSignedIn()
        && (isSuperAdmin() || isGalleryAdmin() || isTechnician())
        && resource.data.galleryId in myGalleryIds() || isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','acknowledgedAt','acknowledgedByUserId',
          'resolvedAt','resolvedByUserId',
        ]);
      allow delete: if false;
    }

    // ================================================================
    // INCIDENTS
    // ================================================================
    match /incidents/{incidentId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds())
        || (resource.data.shopId != null && resource.data.shopId in myShopIds())
      );
      allow create: if isSignedIn()
        && (isSuperAdmin() || isGalleryAdmin() || isTechnician())
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.status == 'OPEN';
      allow update: if isSignedIn()
        && (isSuperAdmin() || ((isGalleryAdmin() || isTechnician()) && resource.data.galleryId in myGalleryIds()));
      allow delete: if false;
    }

    // ================================================================
    // INVOICES
    // ================================================================
    match /invoices/{invoiceId} {
      allow read: if isSignedIn()
        && !isShopWorker()
        && (
          isSuperAdmin()
          || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds())
          || (resource.data.shopId != null && resource.data.shopId in myShopIds())
        );
      allow create: if isSignedIn()
        && (isSuperAdmin() || isGalleryAdmin())
        && request.resource.data.generatedByUserId == uid()
        && request.resource.data.meterId is string
        && exists(/databases/$(database)/documents/meters/$(request.resource.data.meterId))
        && get(/databases/$(database)/documents/meters/$(request.resource.data.meterId)).data.galleryId == request.resource.data.galleryId
        && (isSuperAdmin() || request.resource.data.galleryId in myGalleryIds());
      allow update, delete: if false;
    }

    // ================================================================
    // AUDIT LOGS — write par tout utilisateur authentifié, actorUserId == uid
    // ================================================================
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || (isGalleryAdmin() && resource.data.galleryId in myGalleryIds())
      );
      allow create: if isSignedIn()
        && request.resource.data.actorUserId == uid();
      allow update, delete: if false;
    }

    // ================================================================
    // COUNTERS — lecture+write pour numérotation séquentielle
    // ================================================================
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.value == 1;
      allow update: if isSignedIn()
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // ================================================================
    // SETTINGS
    // ================================================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ================================================================
    // CATCH-ALL
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
