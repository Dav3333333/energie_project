# Firebase Web SDK — valeurs publiques, obtenues dans la console Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulateurs (dev) — mettre "true" pour brancher les émulateurs
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# App Check (production) — reCAPTCHA v3 site key (aucune clé secrète ici)
VITE_RECAPTCHA_V3_SITE_KEY=